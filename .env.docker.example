# Docker Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Frontend Configuration
# ============================================

# Backend URL (must be accessible from browser)
# For VPS deployment, use your domain or IP
VITE_BACKEND_URL=http://localhost:3001

# Convex Configuration (Cloud service - get from Convex dashboard)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk Auth Configuration
# Use the production publishable key from Clerk Dashboard -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxx

# Clerk Frontend API URL is not used by Docker directly.
# Set it on the production Convex deployment as CLERK_JWT_ISSUER_DOMAIN:
# npx convex env set --prod CLERK_JWT_ISSUER_DOMAIN https://your-production-clerk-frontend-api-url

# ============================================
# Backend Configuration
# ============================================

# Resend Configuration (get from Resend dashboard)
RESEND_API_KEY=your_resend_api_key_here
RESEND_DOMAIN=yourdomain.com
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# Convex Admin Configuration (get from Convex dashboard settings)
CONVEX_HTTP_URL=https://your-deployment.convex.site
CONVEX_ADMIN_KEY=your_convex_admin_key_here

# Backend URL (for Convex webhooks to reach your backend)
# For VPS deployment, use your domain or IP
BACKEND_URL=http://localhost:3001
