# Backend URL for local email service
VITE_BACKEND_URL=http://localhost:3001

# Convex actions read this from Convex env, not from the Vite client env.
# Set it locally with `pnpm exec convex env set BACKEND_URL http://localhost:3001`
# and in production with:
# `pnpm exec convex env set --prod BACKEND_URL https://delegateapi.sudocreate.app`
BACKEND_URL=http://localhost:3001
