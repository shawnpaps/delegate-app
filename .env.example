# Delegate Docker environment
# Copy this file to .env on your server and fill in the secret values.

# Public domains
FRONTEND_HOST=delegate.sudocreate.app
BACKEND_HOST=delegateapi.sudocreate.app
BACKEND_URL=https://delegateapi.sudocreate.app

# Existing Traefik Docker network and routing settings
TRAEFIK_NETWORK=traefik-qfiy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Frontend build-time configuration
VITE_BACKEND_URL=https://delegateapi.sudocreate.app
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk Frontend API URL is configured in Convex, not Docker:
# pnpm exec convex env set --prod CLERK_JWT_ISSUER_DOMAIN https://your-production-clerk-frontend-api-url

# Backend container
PORT=3001

# Resend
RESEND_API_KEY=
RESEND_DOMAIN=sudocreate.app
RESEND_WEBHOOK_SECRET=

# Convex
# Use the Convex HTTP actions URL for the target deployment.
CONVEX_HTTP_URL=
CONVEX_ADMIN_KEY=
