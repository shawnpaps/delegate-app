# Delegate Docker environment
# Copy this file to .env on your server and fill in the secret values.

# Public domains
FRONTEND_HOST=delegate.sudocreate.app
BACKEND_HOST=delegateapi.sudocreate.app
BACKEND_URL=https://delegateapi.sudocreate.app

# Existing Caddy Docker network
CADDY_NETWORK=caddy

# Frontend build-time configuration
VITE_BACKEND_URL=https://delegateapi.sudocreate.app
VITE_CONVEX_URL=
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=https://delegate.sudocreate.app/callback

# Backend container
PORT=3001

# Resend
RESEND_API_KEY=
RESEND_DOMAIN=sudocreate.app
RESEND_WEBHOOK_SECRET=

# Convex
# Use the Convex HTTP actions URL for the target deployment.
CONVEX_HTTP_URL=
CONVEX_ADMIN_KEY=
