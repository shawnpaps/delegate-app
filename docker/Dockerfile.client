# Multi-stage build for the client (React + Vite)
FROM node:22-alpine AS builder

ARG VITE_CONVEX_URL
ARG VITE_BACKEND_URL
ARG VITE_WORKOS_CLIENT_ID
ARG VITE_WORKOS_REDIRECT_URI

ENV VITE_CONVEX_URL=$VITE_CONVEX_URL
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_WORKOS_CLIENT_ID=$VITE_WORKOS_CLIENT_ID
ENV VITE_WORKOS_REDIRECT_URI=$VITE_WORKOS_REDIRECT_URI

WORKDIR /app

COPY client/package.json ./
RUN npm pkg set "devDependencies.vite=npm:@voidzero-dev/vite-plus-core@latest" \
  "devDependencies.vite-plus=latest" \
  "devDependencies.@tailwindcss/vite=^4.2.4"
RUN npm install --legacy-peer-deps

COPY client/ ./
RUN npx vp build

FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
